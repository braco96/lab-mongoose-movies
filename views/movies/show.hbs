<!-- Detalle de una película -->
<h2>{{movie.title}}</h2>
<p>Género: {{movie.genre}}</p>
<p>Trama: {{movie.plot}}</p>
<!-- Listado de las celebridades en el reparto -->
<ul>
  {{#each movie.cast}}
    <li>{{this.name}}</li>
  {{/each}}
</ul>
<!-- Formulario para eliminar la película -->
<form action="/movies/{{movie._id}}/delete" method="POST">
  <button type="submit">Eliminar</button>
</form>
<!-- Enlace para editar la película -->
<a href="/movies/{{movie._id}}/edit">Editar</a>
<a href="/movies">Volver al listado</a>
