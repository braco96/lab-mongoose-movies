<h2>Nueva Celebridad</h2>
<!-- Formulario para crear una nueva celebridad -->
<form action="/celebrities" method="POST">
  <label>Nombre</label>
  <input type="text" name="name" />
  <label>Ocupación</label>
  <input type="text" name="occupation" />
  <label>Frase</label>
  <input type="text" name="catchPhrase" />
  <button type="submit">Crear</button>
</form>
<a href="/celebrities">Volver al listado</a>
